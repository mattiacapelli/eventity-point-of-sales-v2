HOST=0.0.0.0
PORT=3000
DATABASE_URL=./pos.db

# 30 days, in seconds
SESSION_TTL_SECONDS=2592000

# Must be a strong random string (min 32 chars) in production.
# Required when NODE_ENV=production — startup fails if left at the insecure default below.
JWT_SECRET=change-me-in-production-minimum-32-chars!

# debug | info | warn | error
LOG_LEVEL=info

# development | production | test
NODE_ENV=development

# Comma-separated list of allowed CORS origins. Empty = allow all (development only).
CORS_ORIGINS=

# IANA timezone for receipt timestamps
TZ=Europe/Rome

# Base directory for persistent data (logos, fonts, images). Defaults to /data in production.
DATA_DIR=/data
