{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@core/*":       ["./src/core/*"],
      "@components/*": ["./src/components/*"],
      "@screens/*":    ["./src/screens/*"],
      "@state/*":      ["./src/state/*"],
      "@styles/*":     ["./src/styles/*"]
    }
  },
  "include": ["src"]
}
