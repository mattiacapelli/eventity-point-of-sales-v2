PORT=4000
DB_PATH=./data/web-ui.db
DATA_DIR=./data

# Required in production — falls back to an insecure default if unset.
JWT_SECRET=dev-secret-change-in-production

# Comma-separated list of allowed origins. Falls back to "*" (warns in production) if unset.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# development | production
NODE_ENV=development

# debug | info | warn | error
LOG_LEVEL=info

# Optional — used to seed the initial superadmin account.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
